from __future__ import annotations

from google.adk.tools import FunctionTool


def echo(message: str) -> str:
    """Echo a message back to the model.

    Args:
        message: Any string the model wants to read back. Useful for testing
            that tool wiring is working without external dependencies.

    Returns:
        The message prefixed with "echo:".
    """
    return f"echo: {message}"


# Pre-wrapped FunctionTool — import this from agent.py.
echo_tool = FunctionTool(func=echo)
